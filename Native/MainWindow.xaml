<Window x:Class="Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Native.Views"
        Title="Native"
        Width="410" Height="740" MinWidth="370" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource LabelPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="pack://application:,,,/Assets/Native.ico"
        UseLayoutRounding="True"
        Topmost="{Binding KeepOnTop, Mode=OneWay}"
        AllowDrop="True" PreviewDragEnter="Window_DragEnter" PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave" PreviewDrop="Window_Drop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================== barra de título ======================== -->
        <Grid Grid.Row="0">
            <!-- à esquerda: Não Perturbe, Ajustes e Fixar -->
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Button Content="&#xE708;" Command="{Binding ToggleDoNotDisturbCommand}" ToolTip="{Binding DoNotDisturbTooltip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DoNotDisturb}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemPurple}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="&#xE713;" Command="{Binding ToggleSettingsCommand}" ToolTip="Ajustes (Ctrl + ,)" Margin="2,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsTab}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding ToggleKeepOnTopCommand}" ToolTip="{Binding KeepOnTopTooltip}" Margin="2,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE718;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding KeepOnTop}" Value="True">
                                    <Setter Property="Content" Value="&#xE841;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <TextBlock Text="Native" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource LabelSecondary}"/>

            <!-- à direita: botões do Windows -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar (continua rodando na bandeja)"/>
            </StackPanel>
        </Grid>

        <!-- ======================== cartão do iPhone ======================== -->
        <Border Grid.Row="1" Margin="16,2,16,10" Padding="16,14" CornerRadius="16" Background="{DynamicResource CardBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- silhueta do iPhone -->
                <Border Width="29" Height="52" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource PhoneOutline}"
                        VerticalAlignment="Center">
                    <Border Width="10" Height="3.5" CornerRadius="1.75" Background="{DynamicResource PhoneOutline}"
                            VerticalAlignment="Top" Margin="0,4,0,0"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeviceName}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ModelName}" FontSize="12" Foreground="{DynamicResource LabelSecondary}"
                               Visibility="{Binding HasModel, Converter={StaticResource Vis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SystemOrange}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                            <Setter Property="Fill" Value="{DynamicResource SystemGreen}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="problem">
                                            <Setter Property="Fill" Value="{DynamicResource SystemRed}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5"
                                   Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                   ToolTip="{Binding StatusText}"/>
                        <!-- bateria -->
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Background="Transparent"
                                    ToolTip="{Binding BatteryTooltip}"
                                    Visibility="{Binding HasBattery, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding BatteryText}" Foreground="{DynamicResource LabelSecondary}"
                                       FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Grid Width="24" Height="12" VerticalAlignment="Center">
                                <Border Width="22" HorizontalAlignment="Left" CornerRadius="3.5"
                                        BorderThickness="1.2" BorderBrush="{DynamicResource BatteryOutline}"/>
                                <Border Height="7" HorizontalAlignment="Left" Margin="2.5,0,0,0" CornerRadius="1.8"
                                        Width="{Binding BatteryFillWidth}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BatteryFill}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BatteryLow}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SystemRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShowChargeBolt}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SystemGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="1.6" Height="4" HorizontalAlignment="Right" CornerRadius="0,1,1,0"
                                        Background="{DynamicResource BatteryOutline}"/>
                            </Grid>
                            <!-- raio de carregando, como no iPhone -->
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="3,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SystemGreen}"
                                       Visibility="{Binding ShowChargeBolt, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource PillButton}" VerticalAlignment="Center"
                        Command="{Binding MirrorCommand}" ToolTip="Ver a tela do iPhone neste PC (AirPlay)">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter ContentTemplate="{StaticResource AirPlayGlyph}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MirrorButtonText}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ======================== tocando agora ======================== -->
        <Border Grid.Row="2" Margin="16,0,16,10" Padding="14,12,14,8" CornerRadius="16" Background="{DynamicResource CardBg}"
                Visibility="{Binding HasNowPlaying, Converter={StaticResource Vis}}">
            <v:NowPlayingView/>
        </Border>

        <!-- ======================== abas ======================== -->
        <Border Grid.Row="3" Margin="16,0,16,8" Padding="2" CornerRadius="9" Background="{DynamicResource SegmentTrack}"
                Visibility="{Binding ShowSetup, Converter={StaticResource NotVis}}">
            <UniformGrid Columns="4">
                <RadioButton Style="{StaticResource Segment}" Content="Notificações" IsChecked="{Binding IsNotificationsTab}" ToolTip="Ctrl+1"/>
                <RadioButton Style="{StaticResource Segment}" Content="Mensagens" IsChecked="{Binding IsMessagesTab}" ToolTip="Ctrl+2"/>
                <RadioButton Style="{StaticResource Segment}" Content="Telefone" IsChecked="{Binding IsPhoneTab}" ToolTip="Ctrl+3"/>
                <RadioButton Style="{StaticResource Segment}" Content="Arquivos" IsChecked="{Binding IsFilesTab}" ToolTip="Mandar e receber arquivos (Ctrl+4)"/>
            </UniformGrid>
        </Border>

        <!-- ======================== conteúdo ======================== -->
        <Grid Grid.Row="4">
            <v:SetupView Visibility="{Binding ShowSetup, Converter={StaticResource Vis}}"/>
            <Grid Visibility="{Binding ShowSetup, Converter={StaticResource NotVis}}">
                <v:NotificationsView Visibility="{Binding IsNotificationsTab, Converter={StaticResource Vis}}"/>
                <v:MessagesView DataContext="{Binding Messages}"
                                Visibility="{Binding DataContext.IsMessagesTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>
                <v:PhoneView DataContext="{Binding Phone}"
                             Visibility="{Binding DataContext.IsPhoneTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>
                <v:FilesView DataContext="{Binding Files}"
                             Visibility="{Binding DataContext.IsFilesTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>
                <v:SettingsView Visibility="{Binding IsSettingsTab, Converter={StaticResource Vis}}"/>
            </Grid>
        </Grid>

        <!-- ======================== soltar arquivos ======================== -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="5" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="{DynamicResource WindowBg}" Opacity="0.92" CornerRadius="10"/>
            <Rectangle Margin="14" RadiusX="16" RadiusY="16" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="6 4"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Accent}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Soltar para mandar ao iPhone" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="Aparece no Native do iPhone" Foreground="{DynamicResource LabelSecondary}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ======================== painel (sheet) ======================== -->
        <Grid Grid.RowSpan="5" Background="{DynamicResource OverlayDim}"
              Visibility="{Binding IsSheetOpen, Converter={StaticResource Vis}}">
            <Border Background="{DynamicResource SheetBg}" CornerRadius="16" Margin="22" Padding="22,22,22,16"
                    VerticalAlignment="Center" BorderBrush="{DynamicResource SheetBorder}" BorderThickness="1">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Accent}" HorizontalAlignment="Center">
                        <Viewbox Width="26" Height="24">
                            <Canvas Width="24" Height="22">
                                <Path Data="M6,16 H3.5 A2.5,2.5 0 0 1 1,13.5 V4.5 A2.5,2.5 0 0 1 3.5,2 H20.5 A2.5,2.5 0 0 1 23,4.5 V13.5 A2.5,2.5 0 0 1 20.5,16 H18"
                                      Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M12,12.5 L18.5,21 H5.5 Z" Fill="White"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{Binding SheetTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,6"/>
                    <TextBlock Text="{Binding SheetBody}" Foreground="{DynamicResource LabelSecondary}" TextAlignment="Center"
                               TextWrapping="Wrap" LineHeight="19"/>
                    <Button Style="{StaticResource PillButton}" Content="Localizar o programa" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" Command="{Binding LocateUxPlayCommand}"
                            Visibility="{Binding SheetShowLocate, Converter={StaticResource Vis}}"/>
                    <Button Style="{StaticResource TextButton}" Content="OK" Margin="0,8,0,0" Padding="20,6"
                            HorizontalAlignment="Center" Command="{Binding CloseSheetCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
