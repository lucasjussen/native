<Window x:Class="Native.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Native.Controls"
        Title="Native"
        Width="352" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="{Binding MiniPinned, Mode=OneWay}" ShowActivated="False"
        Foreground="{DynamicResource LabelPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" AllowDrop="True"
        PreviewDragOver="Window_DragOver" PreviewDragLeave="Window_DragLeave" PreviewDrop="Window_Drop">

    <!-- Mini Native: o essencial do iPhone, fixo por cima de tudo. DataContext = MainViewModel. -->
    <Window.Resources>
        <Style x:Key="MiniIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Uma notificação no jeito do iPhone: ícone do app, título em negrito com a hora à direita e o
             texto em até duas linhas. Todas iguais, de qualquer app; o "x" aparece no lugar da hora ao passar o mouse. -->
        <DataTemplate x:Key="NotifRow">
            <Grid x:Name="Row" Background="Transparent">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <c:AppIconView App="{Binding App}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,1,0,0"/>
                    <StackPanel Grid.Column="1" Margin="10,0,2,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="Time" Grid.Column="1" Text="{Binding TimeLabel}" FontSize="11.5" Margin="8,1,0,0"
                                       Foreground="{DynamicResource LabelSecondary}"/>
                            <!-- ao passar o mouse a hora dá lugar ao "x" -->
                            <Button x:Name="Dismiss" Grid.Column="1" Style="{StaticResource CircleButton}" Width="20" Height="20"
                                    Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,0,0"
                                    Visibility="Hidden" Click="Dismiss_Click" ToolTip="Limpar (também no iPhone)"/>
                        </Grid>
                        <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{DynamicResource LabelBody}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight" Margin="0,1,0,0"
                                   Visibility="{Binding HasMessage, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Dismiss" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Time" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="{DynamicResource FloatMargin}">
        <Border CornerRadius="{DynamicResource FloatRadius}" Background="{DynamicResource BannerShadow}"
                Visibility="{DynamicResource FloatShadow}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Card" CornerRadius="{DynamicResource FloatRadius}" Background="{DynamicResource BannerBg}" BorderBrush="{DynamicResource BannerBorder}"
                BorderThickness="1" MouseLeftButtonDown="Drag">
            <StackPanel>
                <!-- ================= iPhone ================= -->
                <Grid Margin="14,12,10,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="22" Height="38" CornerRadius="6" BorderThickness="1.8" BorderBrush="{DynamicResource PhoneOutline}"
                            VerticalAlignment="Center">
                        <Border Width="8" Height="2.6" CornerRadius="1.3" Background="{DynamicResource PhoneOutline}"
                                VerticalAlignment="Top" Margin="0,3,0,0"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SystemOrange}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                                <Setter Property="Fill" Value="{DynamicResource SystemGreen}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="problem">
                                                <Setter Property="Fill" Value="{DynamicResource SystemRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource LabelSecondary}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120"/>

                            <!-- bateria -->
                            <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center" Background="Transparent"
                                        ToolTip="{Binding BatteryTooltip}" Visibility="{Binding HasBattery, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding BatteryText}" FontSize="12" Foreground="{DynamicResource LabelSecondary}"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <Grid Width="24" Height="12" VerticalAlignment="Center">
                                    <Border Width="22" HorizontalAlignment="Left" CornerRadius="3.5"
                                            BorderThickness="1.2" BorderBrush="{DynamicResource BatteryOutline}"/>
                                    <Border Height="7" HorizontalAlignment="Left" Margin="2.5,0,0,0" CornerRadius="1.8"
                                            Width="{Binding BatteryFillWidth}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BatteryFill}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BatteryLow}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SystemRed}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShowChargeBolt}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SystemGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Border Width="1.6" Height="4" HorizontalAlignment="Right" CornerRadius="0,1,1,0"
                                            Background="{DynamicResource BatteryOutline}"/>
                                </Grid>
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="3,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource SystemGreen}"
                                           Visibility="{Binding ShowChargeBolt, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE708;" Command="{Binding ToggleDoNotDisturbCommand}" ToolTip="{Binding DoNotDisturbTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MiniIcon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DoNotDisturb}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemPurple}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ToggleMiniPinCommand}" ToolTip="{Binding MiniPinTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MiniIcon}">
                                    <Setter Property="Content" Value="&#xE718;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MiniPinned}" Value="True">
                                            <Setter Property="Content" Value="&#xE841;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource MiniIcon}" Content="&#xE740;" Click="Expand_Click" ToolTip="Abrir o Native completo"/>
                        <Button Style="{StaticResource MiniIcon}" Content="&#xE921;" Click="Hide_Click"
                                ToolTip="Esconder (volta pelo ícone da bandeja ou Ctrl + Alt + N)"/>
                    </StackPanel>
                </Grid>

                <!-- ================= tocando agora ================= -->
                <Border Height="1" Background="{DynamicResource Separator}" Visibility="{Binding HasNowPlaying, Converter={StaticResource Vis}}"/>
                <Grid Margin="14,10,10,10" Visibility="{Binding HasNowPlaying, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF375F" Offset="0"/>
                                <GradientStop Color="#BF5AF2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TrackTitle}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TrackArtist}" FontSize="11.5" Foreground="{DynamicResource LabelSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MediaButton}" Width="30" Height="30" FontSize="13" Content="&#xE892;"
                                Command="{Binding PreviousTrackCommand}" ToolTip="Anterior"/>
                        <Button Style="{StaticResource MediaButton}" Width="32" Height="32" FontSize="16" Content="{Binding PlayPauseGlyph}"
                                Command="{Binding PlayPauseCommand}" ToolTip="Tocar/Pausar"/>
                        <Button Style="{StaticResource MediaButton}" Width="30" Height="30" FontSize="13" Content="&#xE893;"
                                Command="{Binding NextTrackCommand}" ToolTip="Próxima"/>
                    </StackPanel>
                </Grid>

                <!-- ================= notificações ================= -->
                <Border Height="1" Background="{DynamicResource Separator}"/>
                <Grid>
                    <!-- vazio -->
                    <StackPanel Orientation="Horizontal" Margin="16,14" Visibility="{Binding HasNotifications, Converter={StaticResource NotVis}}">
                        <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource LabelTertiary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Sem notificações" Margin="9,0,0,0" FontSize="12.5" Foreground="{DynamicResource LabelSecondary}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding RecentNotifications}" Margin="0,8,0,4"
                                  Visibility="{Binding StackNotifications, Converter={StaticResource NotVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" Margin="10,0,10,6" Padding="11,9,11,9" CornerRadius="14"
                                        Background="{DynamicResource NotifBg}" Cursor="Hand" MouseLeftButtonUp="Notification_Click">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NotifRow}"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource NotifHover}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- pilhas: uma por app, com cartões atrás; clicar abre/fecha a pilha -->
                    <ItemsControl ItemsSource="{Binding RecentGroups}" Margin="0,8,0,6"
                                  Visibility="{Binding StackNotifications, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Stack" Margin="10,0,10,8" Background="Transparent">
                                    <!-- cartões empilhados atrás -->
                                    <Border Background="{DynamicResource NotifLayer2}" CornerRadius="12" Height="20"
                                            VerticalAlignment="Bottom" Margin="18,0,18,-8"
                                            Visibility="{Binding ShowSecondLayer, Converter={StaticResource Vis}}"/>
                                    <Border Background="{DynamicResource NotifLayer1}" CornerRadius="13" Height="20"
                                            VerticalAlignment="Bottom" Margin="9,0,9,-4"
                                            Visibility="{Binding HasMore, Converter={StaticResource Vis}}"/>
                                    <Border x:Name="Face" Background="{DynamicResource NotifBg}" CornerRadius="14" Padding="11,9,11,9"
                                            Cursor="Hand" MouseLeftButtonUp="Stack_Click">
                                        <StackPanel>
                                            <!-- cabeçalho da pilha aberta -->
                                            <Grid Margin="2,0,0,4" Visibility="{Binding CanCollapse, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding App.DisplayName}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Mostrar menos" FontSize="11.5" Foreground="{DynamicResource Accent}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ItemsControl ItemsSource="{Binding VisibleItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NotifRow}" Margin="0,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <!-- quantas há na pilha -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,-7"
                                            Background="{DynamicResource ControlFill}" CornerRadius="8" Padding="6,1"
                                            IsHitTestVisible="False" Visibility="{Binding HasMore, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding StackBadge}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource LabelSecondary}"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Stack" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Face" Property="Background" Value="{DynamicResource NotifHover}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- rodapé -->
                <Grid Margin="16,0,12,10" Visibility="{Binding HasNotifications, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding MoreNotificationsText}" FontSize="11.5" Foreground="{DynamicResource LabelSecondary}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" FontSize="12" Content="Limpar tudo"
                            Command="{Binding ClearAllCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
        <!-- Liquid Glass: reflexo no topo (transparente fora do modo vidro) -->
        <Border CornerRadius="{DynamicResource FloatRadius}" Background="{DynamicResource GlassSheen}" IsHitTestVisible="False" Margin="1"/>

        <!-- soltar arquivos -->
        <Border x:Name="DropOverlay" CornerRadius="{DynamicResource FloatRadius}" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource BannerBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Accent}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Soltar para mandar ao iPhone" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
