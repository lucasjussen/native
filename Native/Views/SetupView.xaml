<UserControl x:Class="Native.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Guia de conexão. DataContext = MainViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="20,4,20,24">
            <TextBlock Text="{Binding SetupHeadline}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
            <TextBlock Text="Leva uns dois minutos e só precisa ser feito uma vez." Foreground="{DynamicResource LabelSecondary}"
                       Margin="0,4,0,16" TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Background="{DynamicResource CardBg}" CornerRadius="14" Padding="14,12" Margin="0,0,0,10"
                                Opacity="0.55">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="26" Height="26" VerticalAlignment="Top" Margin="0,0,12,0">
                                    <Ellipse x:Name="Dot" Fill="{DynamicResource ControlFill}"/>
                                    <TextBlock x:Name="Mark" Text="{Binding Number}" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="Detail" Text="{Binding Detail}" TextWrapping="Wrap" LineHeight="18"
                                               Foreground="{DynamicResource LabelSecondary}" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource PillButton}" Content="{Binding ActionLabel}" Command="{Binding Action}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Visibility="{Binding ShowAction, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="1"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Mark" Property="Foreground" Value="White"/>
                                <Setter TargetName="Detail" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="1"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemGreen}"/>
                                <Setter TargetName="Mark" Property="Text" Value="&#xE73E;"/>
                                <Setter TargetName="Mark" Property="FontFamily" Value="{StaticResource IconFont}"/>
                                <Setter TargetName="Mark" Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Padding="14,12" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="2,0,12,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SystemOrange}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                        <Setter Property="Fill" Value="{DynamicResource SystemGreen}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="problem">
                                        <Setter Property="Fill" Value="{DynamicResource SystemRed}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Style="{StaticResource GrayPill}" Content="Tentar agora" Command="{Binding RetryCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource TextButton}" Content="Ver o app mesmo assim" Command="{Binding SkipSetupCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
