<UserControl x:Class="Native.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Native.Controls">
    <!-- DataContext = MainViewModel -->
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="14,9"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style x:Key="Line" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Separator}"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="16,0,16,24">
            <TextBlock Text="Ajustes" Style="{StaticResource PageTitle}" Margin="4,6,0,0"/>

            <!-- aparência -->
            <TextBlock Text="APARÊNCIA" Style="{StaticResource SectionHeader}" Margin="14,14,0,6"/>
            <Border Padding="2" CornerRadius="9" Background="{DynamicResource SegmentTrack}">
                <UniformGrid Columns="3">
                    <RadioButton Style="{StaticResource Segment}" Content="Igual ao Windows" IsChecked="{Binding IsThemeSystem}"/>
                    <RadioButton Style="{StaticResource Segment}" Content="Claro" IsChecked="{Binding IsThemeLight}"/>
                    <RadioButton Style="{StaticResource Segment}" Content="Escuro" IsChecked="{Binding IsThemeDark}"/>
                </UniformGrid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid Style="{StaticResource Row}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Liquid Glass" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Vidro translúcido com reflexo, leve" FontSize="12" Foreground="{DynamicResource LabelSecondary}"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding GlassMode}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14,10"
                    Visibility="{Binding GlassMode, Converter={StaticResource Vis}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Transparência" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="{Binding GlassOpacityText}" FontSize="12" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource LabelSecondary}"/>
                    </Grid>
                    <!-- para a direita = mais transparente -->
                    <Slider Style="{StaticResource MediaSlider}" Margin="0,8,0,2" Minimum="0" Maximum="0.75"
                            Value="{Binding GlassTransparency, Mode=TwoWay}"/>
                    <TextBlock Text="Dica: fixe o Native (alfinete) por cima da série e deixe uns 40–50%." FontSize="11.5"
                               Foreground="{DynamicResource LabelTertiary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14,10"
                    Visibility="{Binding GlassNeedsRestart, Converter={StaticResource Vis}}">
                <Grid>
                    <TextBlock Text="Reabra o Native para a janela ficar transparente." TextWrapping="Wrap" Margin="0,0,110,0"
                               VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource LabelBody}"/>
                    <Button Style="{StaticResource PillButton}" Content="Reabrir agora" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Command="{Binding RestartCommand}"/>
                </Grid>
            </Border>

            <!-- notificações -->
            <TextBlock Text="NOTIFICAÇÕES" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Mostrar banners" Style="{StaticResource SettingLabel}"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ShowBanners}"/>
                    </Grid>
                    <Border Style="{StaticResource Line}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Tocar som" Style="{StaticResource SettingLabel}"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding PlaySound}"/>
                    </Grid>
                    <Border Style="{StaticResource Line}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Não Perturbe" Style="{StaticResource SettingLabel}"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding DoNotDisturb}"/>
                    </Grid>
                    <Border Style="{StaticResource Line}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                            <TextBlock Text="Receber com o iPhone em Foco" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Banner no PC mesmo com Não Perturbe ligado no iPhone" FontSize="12"
                                       Foreground="{DynamicResource LabelSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ShowWhenPhoneSilenced}"/>
                    </Grid>
                    <Border Style="{StaticResource Line}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                            <TextBlock Text="Empilhar por app" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Notificações do mesmo app viram uma pilha; clique para abrir" FontSize="12"
                                       Foreground="{DynamicResource LabelSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding StackNotifications}"/>
                    </Grid>
                    <Border Style="{StaticResource Line}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Copiar códigos de verificação" Style="{StaticResource SettingLabel}"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding AutoCopyCodes}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SectionFooter}"
                       Text="O Não Perturbe daqui (a lua) tira banners e som do PC, mas a lista continua recebendo; ligações ainda aparecem. O Foco do iPhone é separado: com &quot;Receber com o iPhone em Foco&quot;, o PC avisa mesmo com o iPhone silenciado. Códigos de SMS e e-mail (banco, login, 2FA) vão direto para a área de transferência: é só colar com Ctrl + V."/>

            <!-- por app -->
            <TextBlock Text="NOTIFICAÇÕES POR APP" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Os apps aparecem aqui conforme as notificações forem chegando."
                               Foreground="{DynamicResource LabelSecondary}" TextWrapping="Wrap" Margin="14,12"
                               Visibility="{Binding HasNoApps, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding Apps}" AlternationCount="100000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border x:Name="Sep" Height="1" Background="{DynamicResource Separator}"
                                            VerticalAlignment="Top" Margin="54,0,0,0"/>
                                    <Grid Margin="12,8,14,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <c:AppIconView App="{Binding}" Width="29" Height="29"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="13,0,8,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IsAllowed}"/>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                        <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource SectionFooter}"
                       Text="Desligue um app para parar de receber as notificações dele neste PC. No iPhone nada muda."/>

            <!-- contatos -->
            <TextBlock Text="CONTATOS" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Sincronizar a agenda do iPhone" Style="{StaticResource SettingLabel}"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding SyncContacts}"/>
                    </Grid>
                    <Border Style="{StaticResource Line}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{Binding ContactsSummary}" Style="{StaticResource SettingLabel}" Foreground="{DynamicResource LabelSecondary}"/>
                        <Button Style="{StaticResource TextButton}" Content="Apagar do PC" HorizontalAlignment="Right"
                                Foreground="{DynamicResource SystemRed}" Command="{Binding ClearContactsCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SectionFooter}"
                       Text="Com a agenda, as notificações e conversas mostram nome e foto. Ela é atualizada uma vez por dia e fica só neste computador."/>

            <!-- espelhamento -->
            <TextBlock Text="ESPELHAMENTO" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Receptor AirPlay sempre ligado" Style="{StaticResource SettingLabel}"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding AirPlayAlwaysOn}"/>
                    </Grid>
                    <Border Style="{StaticResource Line}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Receptor AirPlay (uxplay-windows)"/>
                            <TextBlock Text="{Binding UxPlayLabel}" FontSize="12" Foreground="{DynamicResource LabelSecondary}"/>
                        </StackPanel>
                        <Button Style="{StaticResource TextButton}" Content="Localizar…" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Command="{Binding LocateUxPlayCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SectionFooter}"
                       Text="Sempre ligado: o PC aparece em Espelhamento de Tela no iPhone a qualquer hora, sem clicar em Espelhar antes."/>

            <!-- geral -->
            <TextBlock Text="GERAL" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Abrir junto com o Windows" Style="{StaticResource SettingLabel}"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding StartWithWindows}"/>
                    </Grid>
                    <Border Style="{StaticResource Line}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Guia de conexão" Style="{StaticResource SettingLabel}"/>
                        <Button Style="{StaticResource TextButton}" Content="Abrir" HorizontalAlignment="Right"
                                Command="{Binding ShowSetupCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SectionFooter}"
                       Text="Atalho: Ctrl + Alt + N abre e fecha o Native de qualquer lugar. Clique com o botão direito numa notificação para mais opções."/>

            <!-- suporte -->
            <TextBlock Text="SUPORTE" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Registros de funcionamento" Style="{StaticResource SettingLabel}"/>
                        <Button Style="{StaticResource TextButton}" Content="Abrir pasta" HorizontalAlignment="Right"
                                Command="{Binding OpenLogsCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Line}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Informações para diagnóstico" Style="{StaticResource SettingLabel}"/>
                        <Button Style="{StaticResource TextButton}" Content="Copiar" HorizontalAlignment="Right"
                                Command="{Binding CopyDiagnosticsCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SectionFooter}"
                       Text="Os registros guardam só estados e erros de conexão, nunca o conteúdo das suas notificações ou mensagens. São apagados depois de 7 dias."/>

            <TextBlock Text="{Binding VersionLabel}" FontSize="11.5" Foreground="{DynamicResource LabelTertiary}"
                       HorizontalAlignment="Center" Margin="0,26,0,0"/>
            <TextBlock Text="Feito por Lucas Jussen" FontSize="11.5" Foreground="{DynamicResource LabelTertiary}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
