<UserControl x:Class="Native.Views.PhoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = PhoneViewModel -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,6,12,6">
            <TextBlock Text="Telefone" Style="{StaticResource PageTitle}"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                    Command="{Binding RefreshRecentsCommand}" ToolTip="Atualizar ligações recentes"/>
        </Grid>

        <!-- discar -->
        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource Field}" Tag="Digite um número" FontSize="14"
                     Text="{Binding DialNumber, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding DialCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Style="{StaticResource GreenPill}" Margin="8,0,0,0" Padding="14,6"
                    Command="{Binding DialCommand}" ToolTip="A ligação começa no iPhone">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE717;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                    <TextBlock Text="Ligar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- recentes / contatos -->
        <Border Grid.Row="2" Margin="16,0,16,6" Padding="2" CornerRadius="9" Background="{DynamicResource SegmentTrack}">
            <UniformGrid Columns="2">
                <RadioButton Style="{StaticResource Segment}" Content="Recentes" IsChecked="{Binding ShowRecents}"/>
                <RadioButton Style="{StaticResource Segment}" Content="Contatos" IsChecked="{Binding ShowContacts}"/>
            </UniformGrid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="20,2,20,6"
                   Visibility="{Binding HasStatus, Converter={StaticResource Vis}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemRed}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- ======================== recentes ======================== -->
        <Grid Grid.Row="4" Visibility="{Binding ShowRecents, Converter={StaticResource Vis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,12" Focusable="False">
                <ItemsControl ItemsSource="{Binding Recents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RowButton}" Padding="8,7"
                                        Command="{Binding DataContext.CallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Ligar (a ligação começa no iPhone)">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Width="38" Height="38" Content="{Binding}" ContentTemplate="{StaticResource Avatar}" Focusable="False"/>
                                        <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="CallName" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                           Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                                <TextBlock Text="{Binding KindLabel}" FontSize="12" Foreground="{DynamicResource LabelSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" FontSize="11.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource LabelSecondary}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMissed}" Value="True">
                                    <Setter TargetName="CallName" Property="Foreground" Value="{DynamicResource SystemRed}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,60"
                        Visibility="{Binding HasNoRecents, Converter={StaticResource Vis}}">
                <TextBlock Text="&#xE717;" FontFamily="{StaticResource IconFont}" FontSize="36"
                           Foreground="{DynamicResource LabelTertiary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nenhuma ligação recente" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
            </StackPanel>
        </Grid>

        <!-- ======================== contatos ======================== -->
        <Grid Grid.Row="4" Visibility="{Binding ShowContacts, Converter={StaticResource Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox Style="{StaticResource Field}" Margin="16,2,16,6" Tag="Buscar contato ou número"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding HasContacts, Converter={StaticResource Vis}}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8" Focusable="False">
                <ItemsControl ItemsSource="{Binding Contacts}" VirtualizingPanel.IsVirtualizing="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Width="38" Height="38" Content="{Binding}" ContentTemplate="{StaticResource Avatar}" Focusable="False"/>
                                    <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource LabelSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Column="1" Style="{StaticResource MediaButton}" Content="&#xE8BD;" FontSize="14"
                                        Foreground="{DynamicResource Accent}" ToolTip="Mensagem" Click="Message_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource MediaButton}" Content="&#xE717;" FontSize="14"
                                        Foreground="{DynamicResource SystemGreen}" ToolTip="Ligar (a ligação começa no iPhone)"
                                        Command="{Binding DataContext.CallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="1" VerticalAlignment="Top" Margin="16,8" Padding="18,16" CornerRadius="14" Background="{DynamicResource CardBg}"
                    Visibility="{Binding HasNoContacts, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="Traga a agenda do iPhone" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Com os contatos no PC, as notificações e conversas mostram nome e foto, e você liga ou manda mensagem direto daqui. A agenda fica só neste computador."
                               TextWrapping="Wrap" Foreground="{DynamicResource LabelSecondary}" Margin="0,4,0,12" LineHeight="18"/>
                    <Button Style="{StaticResource PillButton}" Content="Sincronizar contatos" HorizontalAlignment="Left"
                            Command="{Binding SyncContactsCommand}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="20,4,14,10" Visibility="{Binding HasContacts, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding ContactsSyncLabel}" FontSize="11.5" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource TextButton}" Content="Atualizar agenda" FontSize="12" HorizontalAlignment="Right"
                        Command="{Binding SyncContactsCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
