<UserControl x:Class="Native.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = FilesViewModel. Só a área "Arraste aqui" recebe arquivos; a janela apenas a acende (MainWindow). -->
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardRim}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardRimThickness}"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="SmallIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="16,0,16,24">
            <Grid Margin="4,6,0,0">
                <TextBlock Text="Arquivos" Style="{StaticResource PageTitle}"/>
                <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="Abrir pasta" Command="{Binding OpenFolderCommand}" ToolTip="{Binding ReceiveFolder}"/>
            </Grid>

            <!-- área de soltar: o único lugar que recebe o arquivo -->
            <Grid x:Name="DropZone" Margin="0,12,0,0" Height="150" AllowDrop="True" Background="Transparent"
                  DragEnter="Zone_DragOver" DragOver="Zone_DragOver" DragLeave="Zone_DragLeave" Drop="Zone_Drop">
                <Rectangle x:Name="ZoneFill" RadiusX="14" RadiusY="14" Fill="{DynamicResource CardBg}"/>
                <Rectangle x:Name="ZoneTint" RadiusX="14" RadiusY="14" Fill="{DynamicResource Accent}" Opacity="0"/>
                <Rectangle x:Name="ZoneStroke" RadiusX="14" RadiusY="14" Stroke="{DynamicResource LabelTertiary}"
                           StrokeThickness="1.5" StrokeDashArray="5 4"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="True">
                    <Border x:Name="ZoneIcon" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Accent}"
                            HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="ZoneIconScale"/></Border.RenderTransform>
                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ZoneTitle" Text="Arraste aqui para mandar ao iPhone" FontWeight="SemiBold" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,10,0,8"/>
                    <StackPanel x:Name="ZoneButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource GrayPill}" Content="Escolher arquivos…" Command="{Binding PickFilesCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource GrayPill}" Content="Colar" Command="{Binding PasteCommand}"
                                ToolTip="Ctrl + V: arquivos copiados, um print ou um texto/link"/>
                    </StackPanel>
                    <TextBlock x:Name="ZoneHint" Text="Aparece no Native do iPhone" FontSize="12"
                               Foreground="{DynamicResource LabelSecondary}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- estado -->
            <Grid Margin="6,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource LabelTertiary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPhoneOnline}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SystemGreen}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasServerError}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SystemRed}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource LabelSecondary}"
                               TextWrapping="Wrap" MaxWidth="270"/>
                </StackPanel>
                <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" FontSize="12.5"
                        Command="{Binding TogglePairingCommand}"
                        Visibility="{Binding IsPaired, Converter={StaticResource Vis}}">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="QR code"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPairingRequested}" Value="True">
                                            <Setter Property="Text" Value="Ocultar"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
            </Grid>

            <!-- pareamento -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14"
                    Visibility="{Binding ShowPairing, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="132" Height="132" CornerRadius="10" Background="White" Padding="6" VerticalAlignment="Top"
                            ToolTip="{Binding PairUrl}">
                        <Viewbox Stretch="Uniform">
                            <Path Data="{Binding QrGeometry}" Fill="Black" SnapsToDevicePixels="True"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Ligar o iPhone" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource LabelBody}" Margin="0,6,0,0" LineHeight="18">
                            <Run Text="1. Aponte a Câmera do iPhone para o código e toque no link."/>
                            <LineBreak/>
                            <Run Text="2. No Safari: Compartilhar → Adicionar à Tela de Início."/>
                            <LineBreak/>
                            <Run Text="3. Pronto: o Native vira um app no iPhone."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource LabelSecondary}" Margin="0,8,0,0"
                                   Text="Mesmo Wi-Fi do PC. Se o Windows perguntar, permita o Native em redes privadas."/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding AddressText}" FontSize="11.5" Foreground="{DynamicResource LabelTertiary}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource TextButton}" FontSize="11.5" Content="Novo código" Margin="6,0,0,0"
                                    Command="{Binding NewKeyCommand}" ToolTip="Invalida o código antigo (use se alguém mais tiver escaneado)"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10"
                    Visibility="{Binding HasServerError, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding ServerError}" TextWrapping="Wrap" Foreground="{DynamicResource SystemRed}" FontSize="12.5"/>
            </Border>

            <!-- recentes -->
            <Grid>
                <TextBlock Text="RECENTES" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12"
                        Content="Limpar" Command="{Binding ClearCommand}" Margin="0,0,0,2"
                        Visibility="{Binding HasItems, Converter={StaticResource Vis}}"/>
            </Grid>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <TextBlock TextWrapping="Wrap" Margin="14,14" Foreground="{DynamicResource LabelSecondary}" FontSize="12.5"
                               Visibility="{Binding HasItems, Converter={StaticResource NotVis}}"
                               Text="Nada por aqui ainda. No iPhone, abra o Native da Tela de Início para mandar fotos e arquivos, ou use Compartilhar → Enviar para o PC."/>
                    <ItemsControl ItemsSource="{Binding Items}" AlternationCount="100000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Root" Background="Transparent">
                                    <Border x:Name="Sep" Height="1" Background="{DynamicResource Separator}" VerticalAlignment="Top" Margin="62,0,0,0"/>
                                    <Grid Margin="12,8,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- miniatura -->
                                        <Grid Width="40" Height="40">
                                            <Border CornerRadius="8" Background="{DynamicResource ControlFill}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource LabelSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="8" Visibility="{Binding HasThumbnail, Converter={StaticResource Vis}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <!-- seta: para o iPhone (cima) ou do iPhone (baixo) -->
                                            <Border Width="17" Height="17" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-4,-4" BorderBrush="{DynamicResource CardBg}" BorderThickness="1.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemGreen}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToPhone}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DirectionGlyph}" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                            <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource LabelSecondary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SmallIcon}" Content="&#xE8E5;" ToolTip="Abrir"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource SmallIcon}" Content="&#xE838;" ToolTip="Mostrar na pasta"
                                                    Visibility="{Binding HasPath, Converter={StaticResource Vis}}"
                                                    Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource SmallIcon}" Content="&#xE8C8;" ToolTip="Copiar"
                                                    Visibility="{Binding IsText, Converter={StaticResource Vis}}"
                                                    Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource SmallIcon}" Content="&#xE711;" ToolTip="Tirar da lista (e do iPhone, se ainda não baixou)"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource SectionFooter}">
                <Run Text="O que vem do iPhone fica em"/>
                <Run Text="{Binding ReceiveFolderLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=". Pastas viram .zip. Os arquivos não saem da sua rede."/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
