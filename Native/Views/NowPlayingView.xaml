<UserControl x:Class="Native.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <!-- "Tocando Agora" no estilo do iOS. DataContext = MainViewModel. Usado na janela e no mini player. -->
    <UserControl.Resources>
        <!-- Barrinhas animadas de "tocando" -->
        <Style x:Key="EqBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3"/>
            <Setter Property="RadiusX" Value="1.5"/>
            <Setter Property="RadiusY" Value="1.5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Fill" Value="{DynamicResource LabelSecondary}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
        </Style>
    </UserControl.Resources>

    <StackPanel MouseWheel="Root_MouseWheel" Background="Transparent">
        <!-- faixa -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- capa genérica (o iPhone não envia a arte do álbum por Bluetooth) -->
            <Border Width="46" Height="46" CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF375F" Offset="0"/>
                        <GradientStop Color="#BF5AF2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding TrackTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding TrackArtist}" FontSize="12.5" Foreground="{DynamicResource LabelSecondary}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- tocando: barrinhas animadas; pausado: barrinhas paradas -->
                <Grid Width="20" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                      ToolTip="{Binding PlayerName}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding IsPlaying, Converter={StaticResource Vis}}">
                        <Rectangle Style="{StaticResource EqBar}">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="0.3" To="1" Duration="0:0:0.42"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                        <Rectangle Style="{StaticResource EqBar}">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform>
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="1" To="0.35" Duration="0:0:0.33"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                        <Rectangle Style="{StaticResource EqBar}">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="0.5" To="0.95" Duration="0:0:0.51"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding IsPlaying, Converter={StaticResource NotVis}}">
                        <Rectangle Style="{StaticResource EqBar}" Height="4"/>
                        <Rectangle Style="{StaticResource EqBar}" Height="4"/>
                        <Rectangle Style="{StaticResource EqBar}" Height="4"/>
                    </StackPanel>
                </Grid>

                <!-- abrir/fechar o mini player -->
                <Button x:Name="PipButton" Style="{StaticResource MediaButton}" Width="30" Height="30" FontSize="13"
                        Content="&#xE8A7;" Command="{Binding TogglePipCommand}" ToolTip="Mini player flutuante (fica por cima das janelas)"/>
            </StackPanel>
        </Grid>

        <!-- barra de progresso: arrastar pula a música (quando o app deixa) -->
        <Grid Margin="0,10,0,0" Background="Transparent" ToolTip="{Binding SeekHint}">
            <Slider x:Name="SeekBar" Style="{StaticResource MediaSlider}"
                    Value="{Binding TrackProgress, Mode=TwoWay}"
                    IsHitTestVisible="{Binding CanSeek}"
                    PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up" LostMouseCapture="Seek_Up"/>
        </Grid>
        <Grid Margin="0,0,0,0">
            <TextBlock Text="{Binding ElapsedText}" FontSize="11" Foreground="{DynamicResource LabelSecondary}"/>
            <TextBlock Text="{Binding PlayerName}" FontSize="11" Foreground="{DynamicResource LabelTertiary}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding RemainingText}" FontSize="11" Foreground="{DynamicResource LabelSecondary}" HorizontalAlignment="Right"/>
        </Grid>

        <!-- controles grandes, centralizados como no iPhone -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
            <Button Style="{StaticResource MediaButton}" Width="40" Height="40" Command="{Binding SkipBackwardCommand}"
                    Visibility="{Binding CanSkipBackward, Converter={StaticResource Vis}}" ToolTip="Voltar 15 segundos">
                <Grid>
                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="22"/>
                    <TextBlock Text="15" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Grid>
            </Button>
            <Button Style="{StaticResource MediaButton}" Width="48" Height="44" FontSize="22" Content="&#xE892;"
                    Command="{Binding PreviousTrackCommand}" ToolTip="Anterior" Margin="6,0"/>
            <Button Style="{StaticResource MediaButton}" Width="52" Height="52" FontSize="30" Content="{Binding PlayPauseGlyph}"
                    Command="{Binding PlayPauseCommand}" ToolTip="Tocar/Pausar" Margin="10,0"/>
            <Button Style="{StaticResource MediaButton}" Width="48" Height="44" FontSize="22" Content="&#xE893;"
                    Command="{Binding NextTrackCommand}" ToolTip="Próxima" Margin="6,0"/>
            <Button Style="{StaticResource MediaButton}" Width="40" Height="40" Command="{Binding SkipForwardCommand}"
                    Visibility="{Binding CanSkipForward, Converter={StaticResource Vis}}" ToolTip="Avançar 15 segundos">
                <Grid>
                    <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource IconFont}" FontSize="22"/>
                    <TextBlock Text="15" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Grid>
            </Button>
        </StackPanel>

        <!-- volume do iPhone -->
        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MediaButton}" Width="28" Height="28" FontSize="12" Content="&#xE993;"
                    Foreground="{DynamicResource LabelSecondary}" Command="{Binding VolumeDownCommand}" ToolTip="Diminuir volume"/>
            <Slider Grid.Column="1" Style="{StaticResource MediaSlider}" Margin="4,0" VerticalAlignment="Center"
                    Value="{Binding Volume, Mode=TwoWay}" Visibility="{Binding HasVolume, Converter={StaticResource Vis}}"
                    PreviewMouseLeftButtonDown="Volume_Down" PreviewMouseLeftButtonUp="Volume_Up" LostMouseCapture="Volume_Up"
                    ToolTip="Volume do iPhone (role o mouse sobre o player para ajustar)"/>
            <TextBlock Grid.Column="1" Text="Volume do iPhone" FontSize="11.5" Foreground="{DynamicResource LabelTertiary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasVolume, Converter={StaticResource NotVis}}"/>
            <Button Grid.Column="2" Style="{StaticResource MediaButton}" Width="28" Height="28" FontSize="12" Content="&#xE995;"
                    Foreground="{DynamicResource LabelSecondary}" Command="{Binding VolumeUpCommand}" ToolTip="Aumentar volume"/>
        </Grid>
    </StackPanel>
</UserControl>
