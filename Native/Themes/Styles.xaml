<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Native.Controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- As cores vêm de Dark.xaml ou Light.xaml (trocados em tempo real); por isso tudo aqui usa DynamicResource. -->

    <BooleanToVisibilityConverter x:Key="Vis"/>
    <c:InverseVisibilityConverter x:Key="NotVis"/>
    <c:TextVisibilityConverter x:Key="TextVis"/>
    <c:EmptyTextVisibilityConverter x:Key="EmptyTextVis"/>
    <c:BubbleAlignmentConverter x:Key="BubbleAlign"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Ícone AirPlay (desenhado, para não depender de fonte) -->
    <DataTemplate x:Key="AirPlayGlyph">
        <Viewbox Width="15" Height="14">
            <Canvas Width="24" Height="22">
                <Path Data="M6,16 H3.5 A2.5,2.5 0 0 1 1,13.5 V4.5 A2.5,2.5 0 0 1 3.5,2 H20.5 A2.5,2.5 0 0 1 23,4.5 V13.5 A2.5,2.5 0 0 1 20.5,16 H18"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <Path Data="M12,12.5 L18.5,21 H5.5 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Avatar redondo: foto do contato ou iniciais (DataContext = PersonItem). O tamanho vem de quem usa. -->
    <DataTemplate x:Key="Avatar">
        <Grid>
            <Ellipse Fill="{Binding AvatarBrush}"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" Foreground="White" FontFamily="{StaticResource UiFont}"/>
                </Viewbox>
                <Viewbox Grid.Row="1" Grid.Column="1" Visibility="{Binding Initials, Converter={StaticResource EmptyTextVis}}">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" Foreground="White"/>
                </Viewbox>
            </Grid>
            <Ellipse Visibility="{Binding HasPhoto, Converter={StaticResource Vis}}">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ botões -->

    <Style x:Key="TrafficLight" TargetType="Button">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="#30000000" StrokeThickness="0.5"/>
                        <ContentPresenter x:Name="Glyph" Opacity="0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource IconFont}"
                                          TextElement.FontSize="6.5"
                                          TextElement.Foreground="#99000000"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Botões de minimizar / maximizar / fechar no padrão do Windows 11 -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource IconFont}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TitleHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource IconFont}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#B3271C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrayPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlText}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="11,4"/>
    </Style>

    <Style x:Key="GreenPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource SystemGreen}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="RedPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource SystemRed}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CircleButton" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{DynamicResource CircleFill}" Stroke="{DynamicResource FieldBorder}" StrokeThickness="0.5"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource IconFont}"
                                          TextElement.FontSize="8"
                                          TextElement.Foreground="{DynamicResource CircleGlyph}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource CircleHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão de ícone (barra de título, voltar, etc.) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource IconFont}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TitleHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MediaButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="17" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource IconFont}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverTint}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PressTint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linha clicável de lista (conversa, contato, ligação) -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverTint}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PressTint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SendButton" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{DynamicResource Accent}"/>
                        <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="12" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource CircleFill}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ controles -->

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="7" Background="Transparent" Padding="0,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegmentHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegmentSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="42" Height="26" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="13" Background="{DynamicResource SwitchOff}"/>
                        <Ellipse x:Name="Thumb" Width="22" Height="22" Fill="White"
                                 HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Direction="270"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SystemGreen}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="16" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de texto arredondado; o texto de ajuda vai em Tag -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource LabelPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource LabelTertiary}"
                                       Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="{DynamicResource ScrollThumb}" Margin="1,2"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1"
                            CornerRadius="9" Padding="0,5" MinWidth="190">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,5" Margin="5,0">
                        <ContentPresenter x:Name="Content" ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource MenuBorder}" Margin="10,5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TooltipBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TooltipText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>


    <!-- ============================================================ barra de mídia (estilo iOS) -->

    <Style x:Key="MediaTrackPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}}" CornerRadius="3"
                                Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MediaSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="c:SliderDrag.IsEnabled" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Tag = espessura da barra -->
        <Setter Property="Tag">
            <Setter.Value>
                <sys:Double>5</sys:Double>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Background="Transparent" Height="20">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource MediaTrackPart}" Command="Slider.DecreaseLarge"
                                              Background="{DynamicResource ProgressFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource MediaTrackPart}" Command="Slider.IncreaseLarge"
                                              Background="{DynamicResource ProgressTrack}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Knob" Opacity="0" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- largura zero: a bolinha flutua sobre a barra sem abrir um buraco nela -->
                                            <Canvas Width="0" Height="0" VerticalAlignment="Center" Background="Transparent">
                                                <Ellipse Width="13" Height="13" Canvas.Left="-6.5" Canvas.Top="-6.5" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" Direction="270"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Canvas>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Knob" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ texto -->

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
        <Setter Property="Margin" Value="14,22,0,6"/>
    </Style>

    <Style x:Key="SectionFooter" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="14,6,14,0"/>
    </Style>

    <Style x:Key="SettingLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,56,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ============================================================ resposta rápida -->

    <!-- Barra de resposta, usada no banner e na lista (DataContext = PhoneNotification) -->
    <DataTemplate x:Key="ReplyBar">
        <StackPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0"
                       Visibility="{Binding ShowReplyButtons, Converter={StaticResource Vis}}">
                <Button Style="{StaticResource GrayPill}" Content="Responder" Command="{Binding StartReplyCommand}"
                        Margin="0,0,6,0" Visibility="{Binding CanReplyInline, Converter={StaticResource Vis}}"/>
                <Button Style="{StaticResource GrayPill}" Content="{Binding ExternalReplyLabel}" Command="{Binding OpenExternalCommand}"
                        Margin="0,0,6,0" Visibility="{Binding HasExternalReply, Converter={StaticResource Vis}}"
                        ToolTip="Abre o app no PC e copia o nome do contato para você colar na busca"/>
                <Button Style="{StaticResource GrayPill}" Content="Ligar de volta" Command="{Binding CallBackCommand}"
                        Visibility="{Binding CanCallBack, Converter={StaticResource Vis}}"
                        ToolTip="A ligação começa no iPhone"/>
            </WrapPanel>

            <Border Margin="0,8,0,0" Padding="12,2,3,2" CornerRadius="16" Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1"
                    Visibility="{Binding IsReplying, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ReplyPlaceholder}" Foreground="{DynamicResource LabelTertiary}"
                               VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                               Margin="2,0,0,0" Visibility="{Binding HasReplyText, Converter={StaticResource NotVis}}"/>
                    <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource LabelPrimary}"
                             CaretBrush="{DynamicResource LabelPrimary}" SelectionBrush="{DynamicResource Accent}" FontSize="13"
                             VerticalContentAlignment="Center" MinHeight="28" Padding="0"
                             IsEnabled="{Binding IsNotSending}" TextWrapping="Wrap" MaxHeight="90"
                             c:FocusOnShow.IsEnabled="True">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendReplyCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding CancelReplyCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource SendButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                            Command="{Binding SendReplyCommand}" IsEnabled="{Binding CanSend}" ToolTip="Enviar (Enter)"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ReplyStatus}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasReplyStatus, Converter={StaticResource Vis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SystemGreen}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReplyFailed}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemRed}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSending}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
