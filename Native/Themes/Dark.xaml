<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta escura, nas cores do sistema da Apple -->
    <SolidColorBrush x:Key="WindowBg" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="CardBg" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="CardHover" Color="#353538"/>
    <SolidColorBrush x:Key="CardLayer1" Color="#262628"/>
    <SolidColorBrush x:Key="CardLayer2" Color="#222224"/>
    <SolidColorBrush x:Key="SegmentTrack" Color="#2A2A2D"/>
    <SolidColorBrush x:Key="SegmentSelected" Color="#636366"/>
    <SolidColorBrush x:Key="SegmentHover" Color="#38383B"/>
    <SolidColorBrush x:Key="Separator" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="LabelPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LabelBody" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="LabelSecondary" Color="#98989F"/>
    <SolidColorBrush x:Key="LabelTertiary" Color="#636366"/>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemGreen" Color="#30D158"/>
    <SolidColorBrush x:Key="SystemRed" Color="#FF453A"/>
    <SolidColorBrush x:Key="SystemOrange" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="SystemPurple" Color="#BF5AF2"/>
    <SolidColorBrush x:Key="PurpleSoft" Color="#33BF5AF2"/>
    <SolidColorBrush x:Key="PurpleText" Color="#D9A3F5"/>
    <SolidColorBrush x:Key="ControlFill" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="ControlFillHover" Color="#48484A"/>
    <SolidColorBrush x:Key="ControlText" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="CircleFill" Color="#4A4A4E"/>
    <SolidColorBrush x:Key="CircleHover" Color="#5A5A5F"/>
    <SolidColorBrush x:Key="CircleGlyph" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#39393D"/>
    <SolidColorBrush x:Key="FieldBg" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="BubbleIncoming" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="BubbleIncomingText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayDim" Color="#A0000000"/>
    <SolidColorBrush x:Key="SheetBg" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="SheetBorder" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#50FFFFFF"/>
    <SolidColorBrush x:Key="MenuBg" Color="#F02C2C2E"/>
    <SolidColorBrush x:Key="MenuBorder" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="MenuText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BannerBg" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="BannerBorder" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="HoverTint" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="PressTint" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="TitleHover" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="PhoneOutline" Color="#AEAEB2"/>
    <SolidColorBrush x:Key="ProgressTrack" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="ProgressFill" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="BatteryOutline" Color="#8E8E93"/>
    <SolidColorBrush x:Key="BatteryFill" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="TooltipBg" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="TooltipText" Color="#FFFFFF"/>
    <Color x:Key="ShadowColor">#000000</Color>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.5</system:Double>
    <!-- Liquid Glass desligado: sem brilho, sombra do cartão igual ao cartão -->
    <SolidColorBrush x:Key="GlassSheen" Color="Transparent"/>
    <SolidColorBrush x:Key="BannerShadow" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="ToastBg" Color="#2C2C2E"/>
    <!-- borda de luz dos cartões: só existe no Liquid Glass -->
    <SolidColorBrush x:Key="CardRim" Color="Transparent"/>
    <Thickness x:Key="CardRimThickness">0</Thickness>
    <SolidColorBrush x:Key="GlassRim" Color="Transparent"/>
    <Thickness x:Key="GlassRimThickness">0</Thickness>
</ResourceDictionary>
