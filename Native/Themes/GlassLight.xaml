<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Liquid Glass (claro) -->
    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F3F6FC" Offset="0"/>
        <GradientStop Color="#E7EBF2" Offset="0.55"/>
        <GradientStop Color="#EEE9F5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C8FFFFFF" Offset="0"/>
        <GradientStop Color="#8CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardHover" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="CardLayer1" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="CardLayer2" Color="#5CFFFFFF"/>
    <SolidColorBrush x:Key="SegmentTrack" Color="#14000000"/>
    <SolidColorBrush x:Key="Separator" Color="#16000000"/>
    <SolidColorBrush x:Key="FieldBg" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="SheetBg" Color="#F5F8F9FC"/>
    <SolidColorBrush x:Key="BannerBg" Color="#F6F7FA"/>
    <SolidColorBrush x:Key="BannerShadow" Color="#000000"/>
    <LinearGradientBrush x:Key="BannerBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#33FFFFFF" Offset="0.5"/>
        <GradientStop Color="#18000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.25"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>
    <!-- banners: quase sólidos, para ler de relance por cima de qualquer coisa -->
    <SolidColorBrush x:Key="ToastBg" Color="#F5F6F7FA"/>
</ResourceDictionary>
